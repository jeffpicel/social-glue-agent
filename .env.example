# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_STRONG=claude-sonnet-5-5
# ANTHROPIC_MODEL_FAST=claude-haiku-5-5
# Discord adapter (python -m discord_adapter.run)
DISCORD_BOT_TOKEN=
