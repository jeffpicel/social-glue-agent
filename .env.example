# Crusoe Managed Inference (OpenAI-compatible). Only the key is required; the rest have defaults.
CRUSOE_API_KEY=
# CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
# CRUSOE_MODEL_STRONG=deepseek-ai/DeepSeek-V4-Pro
# CRUSOE_MODEL_FAST=deepseek-ai/Deepseek-V4-Flash
# You.com search
YOU_API_KEY=
# Optional: Yelp Places API adds specific local venue suggestions to event and restaurant planning.
# YELP_API_KEY=
# Optional: Google/Serper search is tried first for event and restaurant results.
# SERPER_API_KEY=
# Optional: SerpApi checks Google Maps Popular Times before restaurant suggestions.
# SerpApi usage may consume account credits; without this key Gluebot won't suggest a venue.
# SERPAPI_API_KEY=
# Set to 1 to run fully offline with canned responses (also the default when CRUSOE_API_KEY is empty)
FAKE_LLM=
# Model provider: crusoe (default, required for the hackathon) or anthropic
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_STRONG=claude-sonnet-5-5
# ANTHROPIC_MODEL_FAST=claude-haiku-5-5
# Discord adapter (python -m discord_adapter.run)
DISCORD_BOT_TOKEN=
# DISCORD_CHANNEL_IDS=
# TICK_MINUTES=60
