# Crusoe Managed Inference (OpenAI-compatible). Only the key is required; the rest have defaults.
CRUSOE_API_KEY=
# CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
# CRUSOE_MODEL_STRONG=deepseek-ai/DeepSeek-V4-Pro
# CRUSOE_MODEL_FAST=deepseek-ai/DeepSeek-V4-Flash
# You.com search
YOU_API_KEY=
# Set to 1 to run fully offline with canned responses (also the default when CRUSOE_API_KEY is empty)
FAKE_LLM=
